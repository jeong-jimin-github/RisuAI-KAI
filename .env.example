NODE_ENV=production
KAI_HOST=0.0.0.0
KAI_PORT=3210
KAI_PUBLIC_URL=http://localhost:3210
KAI_TRUST_PROXY=false
KAI_DATA_DIR=./data
KAI_CLIENT_DIR=../../dist
KAI_SECRET=change-this-to-a-long-random-production-secret
KAI_ADMIN_EMAIL=admin@example.com
KAI_ADMIN_PASSWORD=change-this-password
# OmniRoute configuration
KAI_OMNIROUTE_URL=http://127.0.0.1:20128
KAI_OMNIROUTE_API_KEY=
# aurora-develop/aurora sidecar (OpenAI-compatible front for the ChatGPT web backend).
# Point this at its /v1 base; leave the key blank unless aurora was started with its own Authorization value.
KAI_AURORA_URL=
KAI_AURORA_KEY=
KAI_NVIDIA_API_KEY=
KAI_OPENROUTER_API_KEY=
KAI_USER_RPM=20
KAI_USER_RPD=500
KAI_ROUTE_MAX_ATTEMPTS=8
KAI_MAX_CARD_UPLOAD_BYTES=536870912
